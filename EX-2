import csv
data = list(csv.reader(open("trainingdata.csv")))
data = data[1:]  # Remove header
concepts = [row[:-1] for row in data]
target = [row[-1] for row in data]
S = concepts[0]
G = [["?" for _ in range(len(S))] for _ in range(len(S))]
for i, h in enumerate(concepts):
    if target[i] == "Yes":
        for j in range(len(S)):
            if h[j] != S[j]:
                S[j] = "?"
                G[j][j] = "?"
    else:
        for j in range(len(S)):
            if h[j] != S[j]:
                G[j][j] = S[j]
            else:
                G[j][j] = "?"
G = [g for g in G if g != ["?"] * len(S)]
print("Final Specific Hypothesis:")
print(S)
print("\nFinal General Hypothesis:")
for g in G:
    print(g)
